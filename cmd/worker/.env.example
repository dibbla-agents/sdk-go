# Server Configuration
# Unique identifier for this worker instance
SERVER_NAME=my-custom-worker

# gRPC Server Configuration
# Address of the workflow server (default: grpc.dibbla.com:443). Leave it
# unset for a worker deployed on the Dibbla platform: the platform sets
# DIBBLA_GRPC_SERVER_ADDRESS to its own address, and this would override it.
# Set it only to reach a different server on purpose, e.g. local development:
# GRPC_SERVER_ADDRESS=localhost:50051

# Authentication
# API token for server authentication (required for production)
# Get this from your Dibbla dashboard settings
SERVER_API_TOKEN=your-token-from-dashboard-settings

# TLS Configuration
# Enable/disable TLS for gRPC connections
# Options: true, false, or leave empty for auto-detection
# Auto-detection: TLS enabled for production addresses, disabled for localhost
# GRPC_USE_TLS=true

# Advanced Configuration
# Communication mode (always "grpc", included for compatibility)
# COMMUNICATION_MODE=grpc

# Path to additional environment file (optional)
# CODEX_ENV_PATH=/path/to/codex.env